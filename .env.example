# 环境变量模板
# 使用方法：复制本文件为 .env.local，把下面的值改成你自己的，保存即可
# （.env.local 已被 .gitignore 忽略，不会提交到 git）

# ---- 数据库连接（宝塔 → 数据库里创建的那个）----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=bloguser
DB_PASSWORD=在这里填数据库密码
DB_NAME=blog

# ---- 后台登录 ----
# 后台登录密码（登录页只需要输这个密码，账号随便填）
ADMIN_PASSWORD=在这里填一个强密码
# Token 签名密钥（随便一长串随机字符，比如 32 位以上的字母数字混合）
ADMIN_SECRET=在这里填一长串随机字符
